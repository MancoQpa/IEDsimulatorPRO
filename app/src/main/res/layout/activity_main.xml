<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_tree"
    tools:context=".MainActivity">

    <!-- Header Bar: azul marino de marca, el mismo del launcher -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/brand_navy"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- App Title -->
        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/header_server"
            style="@style/HeaderStyle" />

        <!-- About Button -->
        <ImageButton
            android:id="@+id/btn_about"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/text_on_primary"
            android:contentDescription="@string/menu_about" />

    </LinearLayout>

    <!-- Filete cian: cierra la barra y ata la app al launcher -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/brand_cyan"
        android:elevation="4dp" />

    <!-- Main Content. FrameLayout para poder superponer el indicador de carga. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Status Indicator -->
                        <View
                            android:id="@+id/view_status_indicator"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/status_indicator"
                            android:backgroundTint="@color/status_stopped" />

                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Estado: DETENIDO"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_stopped"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <!-- IP Address -->
                    <TextView
                        android:id="@+id/tv_ip_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="IP: ---.---.---.---:102"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:background="#F5F5F5"
                        android:padding="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Configuration Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Port Configuration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_port"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_port"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="10102"
                                android:inputType="number"
                                android:fontFamily="monospace"
                                android:gravity="center" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/port_hint"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <!-- Simulation Mode Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_simulation_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_simulation_mode"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- File Selection Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_file_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_select_file"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/btn_select_scl"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="14sp"
                            style="@style/SecondaryButton" />

                        <Button
                            android:id="@+id/btn_start_stop"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/btn_start_server"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="14sp"
                            android:enabled="false"
                            style="@style/PrimaryButton" />

                    </LinearLayout>

                    <!-- File Info -->
                    <TextView
                        android:id="@+id/tv_file_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_no_file"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@android:drawable/ic_menu_save"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/text_secondary" />

                    <!-- Model Info -->
                    <TextView
                        android:id="@+id/tv_model_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Informacion del modelo"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:background="#F5F5F5"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Data Model Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="200dp"
                style="@style/CardStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Header with expand/collapse buttons -->
                    <LinearLayout
                        android:id="@+id/layout_model_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@color/brand_navy">

                        <TextView
                            android:id="@+id/tv_model_header"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_data_model"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_on_primary" />

                        <ImageButton
                            android:id="@+id/btn_maniobra"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_manage"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="@color/brand_amber"
                            android:contentDescription="@string/maniobra_titulo"
                            android:layout_marginEnd="8dp" />

                        <ImageButton
                            android:id="@+id/btn_collapse_all"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_revert"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="@color/text_on_primary"
                            android:contentDescription="@string/menu_collapse_all" />

                        <ImageButton
                            android:id="@+id/btn_expand_all"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="@color/text_on_primary"
                            android:contentDescription="@string/menu_expand_all"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <!-- Data Model Tree -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_data_model"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/background_tree"
                        android:padding="4dp"
                        tools:listitem="@layout/item_tree_node" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

        <!-- Indicador de carga, superpuesto y centrado sobre el contenido.
             Hasta 2026-10-21 vivia dentro de la tarjeta "Modelo de Datos", la ultima de
             la pantalla: en una tablet en horizontal esa tarjeta queda al pie con su alto
             minimo y el indicador se veia apenas (el circulo), sin el mensaje ni los
             segundos, salvo desplazandose. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layout_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardElevation="12dp"
            style="@style/CardStyle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="260dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tv_loading_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="360dp"
                    android:text="@string/msg_loading_scl"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_navy"
        android:padding="8dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IEC 61850 / MMS Protocol"
            android:textSize="11sp"
            android:textColor="@color/text_on_primary"
            android:alpha="0.8" />

    </LinearLayout>

</LinearLayout>
