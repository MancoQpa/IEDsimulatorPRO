<?xml version="1.0" encoding="utf-8"?>
<!--
    Acerca de, con la identidad de la familia IEDNavigator: cabecera en el azul
    marino de marca con el icono y el filete cian, y el contenido en claro
    (IEDNavigator usa FlatLightLaf, o sea UI clara con icono oscuro).

    Los datos tecnicos van en monospace, igual que los valores del arbol y que
    IEDNavigator, que usa Monospaced para todo dato.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:clipToOutline="true">

    <!-- ===== Cabecera de marca ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/brand_navy"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/about_app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.04"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_tagline"
            android:textSize="13sp"
            android:textColor="@color/brand_cyan"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_version"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#8899AA"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Filete cian, el mismo del header principal -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/brand_cyan" />

    <!-- ===== Contenido ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_description"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_primary" />

        <!-- ===== Detalles tecnicos ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_section_tech"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_protocol"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary" />

        <!-- ===== Licencias ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_section_legal"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_library"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_license"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_primary"
            android:layout_marginTop="2dp" />

        <!-- ===== Autor ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_developer"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_developer_name"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_country"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- Bandera de Paraguay -->
            <LinearLayout
                android:layout_width="36dp"
                android:layout_height="24dp"
                android:orientation="vertical"
                android:background="#BDBDBD"
                android:padding="1dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/py_red" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/py_white" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/py_blue" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_copyright"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</LinearLayout>
