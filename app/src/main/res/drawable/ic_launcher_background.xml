<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del launcher: el azul marino de IEDNavigator (#010920), muestreado del
    propio icono de escritorio. Se le suma una retícula tenue, como de esquema
    técnico, que a tamaño chico se lee sólo como textura y refuerza la estética
    de plano de ingeniería sin competir con el motivo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#010920"/>

    <!-- Retícula de fondo, muy tenue -->
    <path
        android:pathData="M18,0 L18,108 M36,0 L36,108 M54,0 L54,108
                          M72,0 L72,108 M90,0 L90,108
                          M0,18 L108,18 M0,36 L108,36 M0,54 L108,54
                          M0,72 L108,72 M0,90 L108,90"
        android:strokeColor="#09C0DB"
        android:strokeWidth="0.5"
        android:strokeAlpha="0.10"
        android:fillColor="#00000000"/>
</vector>
