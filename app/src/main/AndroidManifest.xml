<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ied.simulator">

    <!-- Permisos de red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Permisos de almacenamiento -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Mantener CPU activa para el servidor -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IEDSimulator"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            configChanges: al rotar, Android destruye y recrea la Activity por
            defecto. Eso cerraba el dialogo abierto y perdia el modelo ya
            parseado, que en un SCD de subestacion son mas de cien mil nodos:
            el usuario quedaba de vuelta en la pantalla inicial. Se declara el
            manejo del cambio para que la Activity sobreviva a la rotacion.

            Es seguro no re-inflar el layout porque el unico calificador que se
            usa es sw600dp, que mira el ancho MENOR de la pantalla y por lo tanto
            no cambia al rotar. Si algun dia se agregan recursos -land/, hay que
            volver a evaluar esta decision.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Abrir archivos SCL directamente -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.icd" />
                <data android:pathPattern=".*\\.cid" />
                <data android:pathPattern=".*\\.scd" />
                <data android:pathPattern=".*\\.scl" />
            </intent-filter>
        </activity>

        <!-- Servicio del servidor IED -->
        <service
            android:name=".IEDServerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>

</manifest>
